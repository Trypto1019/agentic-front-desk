# Copy to .env and fill in. Everything is optional: the demo, tests and evals
# run offline with the mock model when these are unset.

# Real model for the demo / evals (OpenRouter, OpenAI-compatible API)
OPENROUTER_API_KEY=your-key-here
AGENT_MODEL=anthropic/claude-sonnet-4.6
# Set to "openrouter" to run the eval harness against a real model
AGENT_EVAL_MODEL=mock

# Optional LLM judge for evals
ANTHROPIC_API_KEY=your-key-here

# Webhook verification
WEBHOOK_SIGNING_KEY=your-signing-key-here
TOOL_WEBHOOK_USER=your-user-here
TOOL_WEBHOOK_PASSWORD=your-password-here

# 32 random bytes, base64 (openssl rand -base64 32); encrypts blocked drafts in audit records
AUDIT_ENCRYPTION_KEY=your-base64-key-here

# Loop limits (clamped: tool calls 0..12, iterations 1..8)
AGENT_MAX_TOOL_CALLS=3
AGENT_MAX_LLM_ITERATIONS=4
